{
  "repository": {
    "app": [
      {
        "version": "2.0.0",
        "dependencies": [
          {"name": "std-kit", "specifier": ""},
          {"name": "posix-plugin", "specifier": "", "marker": "sys_platform != 'linux'"},
          {"name": "unix-plugin", "specifier": ">=2.0", "marker": "sys_platform == 'linux'"}
        ]
      }
    ],
    "std-kit": [{"version": "1.0.0"}],
    "posix-plugin": [{"version": "1.0.0"}],
    "unix-plugin": [
      {"version": "2.1.0"},
      {"version": "2.0.0"}
    ]
  },
  "root": "app",
  "specifier": "",
